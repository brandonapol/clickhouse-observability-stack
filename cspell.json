{
  "version": "0.2",
  "language": "en,en-GB",
  "import": [
    "@cspell/dict-en-gb/cspell-ext.json"
  ],
  "ignorePaths": [
    "node_modules/**",
    "package-lock.json",
    ".git/**",
    "cluster-nodes/*/crds/**",
    "cluster-nodes/clickhouse-operator/files/**",
    "cluster-nodes/grafana/dashboards/**",
    "tests/golden/**"
  ],
  "ignoreRegExpList": [
    "/sha256:[0-9a-f]+/g"
  ],
  "words": [
    "alsologtostderr",
    "altinity",
    "automount",
    "bleve",
    "btrfs",
    "clickhouse",
    "clickhouseexporter",
    "clickhouseinstallation",
    "clickhouseinstallations",
    "clickhouseinstallationtemplates",
    "clickhousekeeperinstallations",
    "clickhouseoperatorconfigurations",
    "confd",
    "configd",
    "crds",
    "customresourcedefinitions",
    "datreeio",
    "distroless",
    "finalizer",
    "finalizers",
    "fips",
    "gomemlimit",
    "gopath",
    "kubeadm",
    "kubeconform",
    "kubelet",
    "logtostderr",
    "lookback",
    "mikefarah",
    "mktemp",
    "nindent",
    "percentunit",
    "pipefail",
    "pipx",
    "readyz",
    "reqps",
    "rhysd",
    "servicegraph",
    "shellcheck",
    "spanmetrics",
    "stderrthreshold",
    "telemetrygen",
    "templatesd",
    "trunc",
    "tsouza",
    "usersd",
    "venv",
    "vmodule",
    "yannh"
  ]
}
